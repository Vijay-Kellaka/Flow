generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseCategory {
  FOOD
  DRINKS
  TRANSPORT
  SHOPPING
  ENTERTAINMENT
  EDUCATION
  HEALTH
  BILLS
  OTHER
}

enum ActivityType {
  TASK_CREATED
  TASK_COMPLETED
  EXPENSE_ADDED
  GOAL_UPDATED
  JOURNAL_UPDATED
  NOTE_CREATED
  BOOKMARK_CREATED
  DASHBOARD_UPDATED
  LOGIN
}

model User {
  id                  String              @id @default(cuid())
  name                String?
  email               String              @unique
  image               String?
  emailVerified       DateTime?
  passwordHash        String?
  journalPasswordHash  String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tasks               Task[]
  expenses            Expense[]
  goals               Goal[]
  journals            JournalEntry[]
  notes               Note[]
  bookmarks           Bookmark[]
  activities          Activity[]
  dashboard           Dashboard?
  accounts            Account[]
  sessions            Session[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  title       String
  completed   Boolean  @default(false)
  completedAt DateTime?
  dueDate     DateTime?
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
}

model Expense {
  id          String          @id @default(cuid())
  userId      String
  amount      Int
  name        String
  category    ExpenseCategory
  spentAt     DateTime
  note        String?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, spentAt])
  @@index([userId, category, spentAt])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  completed   Boolean  @default(false)
  progress    Int      @default(0)
  targetDate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, targetDate])
}

model JournalEntry {
  id          String   @id @default(cuid())
  userId      String
  entryDate   DateTime
  content     String   @db.Text
  mood        String?
  tags        String[]
  wordCount   Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     String   @db.Text
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  title       String
  url         String
  tags        String[]
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Activity {
  id          String       @id @default(cuid())
  userId      String
  type        ActivityType
  message     String
  metadata    Json?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Dashboard {
  id          String   @id @default(cuid())
  userId      String   @unique
  layout      Json
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
